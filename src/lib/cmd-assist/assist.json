		"크기": "크기(+100M = 100MB보다 큰, k·M·G)",
		"열": "몇 번째 칸(1부터, $NF = 마지막)",
		"구분자": "칸을 나누는 글자(: , 탭은 \\t)",
		"시작줄": "처음 줄 번호",
		"끝줄": "마지막 줄 번호",
		"시각": "시각(1 hour ago, today, 2026-11-06 09:00)",
		"포트": "포트 번호"
	},
	"generic": [
		{
			"re": "^\\|$",
			"d": "앞 명령의 출력을 다음 명령의 입력으로(파이프)"
		},
		{
			"re": "^\\|\\|$",
			"d": "앞 명령이 실패하면 다음 명령 실행"
		},
		{
			"re": "^&&$",
			"d": "앞 명령이 성공하면 다음 명령 실행"
		},
		{
			"re": "^;$",
			"d": "앞 명령이 끝나면 다음 명령 실행"
		},
		{
			"re": "^&$",
			"d": "뒤에서(백그라운드로) 실행"
		},
		{
			"re": "^>$",
			"d": "출력을 파일로(덮어쓰기)"
		},
		{
			"re": "^>>$",
			"d": "출력을 파일 끝에 덧붙이기"
		},
		{
			"re": "^<$",
			"d": "파일 내용을 입력으로"
		},
		{
			"re": "^2>$",
			"d": "오류 출력을 파일로"
		},
		{
			"re": "^2>&1$",
			"d": "오류 출력도 일반 출력과 같은 곳으로"
		},
		{
			"re": "^&>$",
			"d": "출력·오류를 모두 파일로"
		},
		{
			"re": "^/dev/null$",
			"d": "버리는 곳(출력을 버림)"
		},
		{
			"re": "^sudo$",
			"d": "root 권한으로 실행"
		},
		{
			"re": "^\\$\\(.*\\)$",
			"d": "괄호 안 명령의 결과로 바꿔 넣기"
		},
		{
			"re": "^\\$\\{?([A-Za-z_][A-Za-z0-9_]*)\\}?$",
			"d": "환경 변수 $1 의 값"
		},
		{
			"re": "^~(/.*)?$",
			"d": "홈 폴더$1"
		},
		{
			"re": "^\\.$",
			"d": "지금 폴더"
		},
		{
			"re": "^\\.\\.$",
			"d": "위 폴더"
		},
		{
			"re": "^.*[*?].*$",
			"d": "이름 패턴(* 아무 글자, ? 한 글자) — 맞는 파일들로 펼쳐짐"
		},
		{
			"re": "^[0-9]+$",
			"d": "숫자 $&"
		}
	],
	"commands": {
		"sed": {
			"sig": [
				{
					"args": [
						{
							"name": "옵션",
							"flag": true,
							"opt": true
						},
						{
							"name": "스크립트",
							"d": "할 일 — s/찾을말/바꿀말/g(바꾸기), /패턴/d(지우기), 1,10p(출력)"
						},
						{
							"name": "파일",
							"d": "읽을 파일 — 없으면 표준 입력",
							"opt": true,
							"many": true
						}
					]
				}
			],
			"takes": ["-e", "-f"],
			"opts": {
				"-i": "파일 직접 수정(원본이 바뀜)",
				"-n": "자동 출력 끄기 — p 로 고른 줄만",
				"-E": "확장 정규식(괄호·+·? 그대로)",
				"-r": "확장 정규식(GNU, -E 와 같음)",
				"-e": "스크립트 하나 더",
				"-f": "스크립트를 파일에서",
				"-s": "파일마다 따로 처리"
			},
			"explain": [
				{
					"re": "^-i(.+)$",
					"d": "파일 직접 수정, 원본은 '$1' 붙여 백업"
				},
				{
					"re": "^s(.)(.+?)\\1(.*?)\\1g$",
					"d": "“$2”를 “$3”(으)로 모두 바꿈"
				},
				{
					"re": "^s(.)(.+?)\\1(.*?)\\1gI$|^s(.)(.+?)\\4(.*?)\\4Ig$",
					"d": "“$2$5”를 “$3$6”(으)로 대소문자 없이 모두 바꿈"
				},
				{
					"re": "^s(.)(.+?)\\1(.*?)\\1$",
					"d": "“$2”를 “$3”(으)로 바꿈(줄마다 처음 하나만)"
				},
				{
					"re": "^s(.)(.+?)\\1(.*?)\\1([0-9]+)$",
					"d": "“$2”를 “$3”(으)로 바꿈(줄마다 $4번째만)"
				},
				{
					"re": "^/(.+)/d$",
					"d": "“$1”이 들어간 줄 지우기"
				},
				{
					"re": "^([0-9]+),([0-9$]+)p$",
					"d": "$1~$2번째 줄 출력"
				},
				{
					"re": "^([0-9]+)p$",
					"d": "$1번째 줄 출력"
				},
				{
					"re": "^([0-9]+),([0-9$]+)d$",
					"d": "$1~$2번째 줄 지우기"
				},
				{
					"re": "^([0-9]+)d$",
					"d": "$1번째 줄 지우기"
				},
				{
					"re": "^/(.+)/p$",
					"d": "“$1”이 들어간 줄 출력"
				}
			],
			"templates": [
				{
					"label": "파일 안 글자 모두 바꾸기",
					"t": "sed -i 's/{{찾을말}}/{{바꿀말}}/g' {{파일}}"
				},
				{
					"label": "몇째 줄부터 몇째 줄까지 보기",
					"t": "sed -n '{{시작줄=1}},{{끝줄=20}}p' {{파일}}"
				},
				{
					"label": "패턴이 든 줄 지우기",
					"t": "sed -i '/{{패턴}}/d' {{파일}}"
				}
			],
			"forms": [
				{
					"id": "sed-replace",
					"label": "sed 글자 바꾸기",
					"d": "파일 안의 글자를 찾아 다른 글자로 바꿉니다.",
					"fields": [
						{
							"name": "from",
							"label": "찾을 말",
							"kind": "text",
							"req": true,
							"esc": "sed",
							"d": "정규식 — . * [ 는 특수 문자"
						},
						{
							"name": "to",
							"label": "바꿀 말",
							"kind": "text",
							"esc": "sed"
						},
						{
							"name": "all",
							"label": "줄마다 모두(g)",
							"kind": "flag",
							"on": "g",
							"def": "g"
						},
						{
							"name": "icase",
							"label": "대소문자 무시(I)",
							"kind": "flag",
							"on": "I"
						},
						{
							"name": "inplace",
							"label": "결과",
							"kind": "select",
							"options": [
								["", "화면에만 보이기(파일 그대로)"],
								["-i", "파일 직접 고치기"],
								["-i.bak", "고치고 .bak 백업 남기기"]
							],
							"def": ""
						},
						{
							"name": "file",
							"label": "파일",
							"kind": "text",
							"src": "files",
							"req": true
						}
					],
					"build": "sed[[ {{inplace}}]] 's/{{from}}/{{to}}/{{all}}{{icase}}' {{file}}",
					"danger": [
						{
							"when": "inplace",
							"d": "파일을 직접 고칩니다 — 되돌리려면 백업(.bak)을 남기세요"
						}
					]
				}
			]
		},
		"find": {
			"sig": [
				{
					"args": [
						{
							"name": "폴더",
