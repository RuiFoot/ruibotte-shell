				"-o": "또는",
				"-delete": "찾은 것을 지움(되돌릴 수 없음)",
				"-exec": "찾은 것마다 명령 실행({} 자리에 이름)",
				"-print": "찾은 경로 출력",
				"-print0": "경로를 NUL 로 구분(xargs -0 와 함께)",
				"-ls": "ls -l 형식으로 출력"
			},
			"explain": [
				{
					"re": "^f$",
					"d": "종류: 일반 파일"
				},
				{
					"re": "^d$",
					"d": "종류: 폴더"
				},
				{
					"re": "^l$",
					"d": "종류: 심볼릭 링크"
				},
				{
					"re": "^\\+([0-9]+)$",
					"d": "$1보다 큼(오래됨)"
				},
				{
					"re": "^-([0-9]+)$",
					"d": "$1보다 작음(최근)"
				},
				{
					"re": "^\\+([0-9]+)([kMG])$",
					"d": "$1$2B보다 큼"
				},
				{
					"re": "^\\{\\}$",
					"d": "찾은 경로가 들어갈 자리"
				},
				{
					"re": "^\\\\;$|^';'$|^;$",
					"d": "-exec 명령의 끝"
				},
				{
					"re": "^\\+$",
					"d": "-exec 에 여러 경로를 한 번에"
				}
			],
			"templates": [
				{
					"label": "이름으로 찾기",
					"t": "find {{폴더=.}} -name '{{이름=*.log}}'"
				},
				{
					"label": "오래된 파일 찾기",
