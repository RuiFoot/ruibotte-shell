					"label": "큰 파일 찾기",
					"t": "find {{폴더=.}} -type f -size +{{크기=100M}}"
				}
			],
			"forms": [
				{
					"id": "find",
					"label": "find 파일 찾기",
					"d": "이름·종류·날짜·크기로 파일을 찾습니다.",
					"fields": [
						{
							"name": "dir",
							"label": "어디서",
							"kind": "text",
							"src": "dirs",
							"def": "."
						},
						{
							"name": "depth",
							"label": "몇 단계 아래까지",
							"kind": "text",
							"d": "비우면 끝까지"
						},
						{
							"name": "type",
							"label": "종류",
							"kind": "select",
							"options": [["", "모두"], ["f", "파일"], ["d", "폴더"], ["l", "링크"]],
							"def": "f"
						},
						{
							"name": "name",
							"label": "이름 패턴",
							"kind": "text",
							"d": "*.log, app-*",
							"esc": "squote"
						},
						{
							"name": "mtime",
							"label": "수정한 지(일)",
							"kind": "text",
							"d": "+7 = 7일 넘게 · -1 = 하루 안",
							"options": [["+7", "7일 넘은"], ["+30", "30일 넘은"], ["-1", "하루 안"]]
						},
						{
							"name": "size",
							"label": "크기",
							"kind": "text",
							"d": "+100M = 100MB 넘는",
							"options": [["+100M", "100MB 넘는"], ["+1G", "1GB 넘는"], ["-1k", "1KB 안"]]
						},
						{
							"name": "action",
							"label": "찾은 뒤",
							"kind": "select",
							"options": [
								["", "경로만 보이기"],
								["-ls", "자세히(크기·날짜) 보이기"],
								["-delete", "지우기"]
							],
							"def": ""
						}
					],
					"build": "find {{dir}}[[ -maxdepth {{depth}}]][[ -type {{type}}]][[ -name '{{name}}']][[ -mtime {{mtime}}]][[ -size {{size}}]][[ {{action}}]]",
