{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuiBotte Shell",
  "version": "0.5.0",
  "identifier": "com.ruibotte.shell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RuiBotte Shell",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "transparent": true,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; frame-src 'self' blob:; object-src blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "RuiBotte",
    "copyright": "© RuiFoot",
    "category": "DeveloperTool",
    "shortDescription": "SSH·SFTP·DB 데스크톱 작업대",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": [
      "resources/rb-jdbc.jar"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2RDcxMkJDQTFCRjMwN0IKUldSN01MK2h2QkxYaHAwNFVUa0ZSZ0VsSWNQTXZRU2VpVzRISlVMUGtMUDVFZzVsaDY4enRiUlkK",
      "endpoints": [
        "https://github.com/RuiFoot/ruibotte-shell/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
